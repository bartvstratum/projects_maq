[advec]
swadvec=2i5
cflmax=1.2
#fluxlimit_list=qt,qr,qs,qg

[boundary]
swboundary=surface
#sbot_2d_list=thl,qt

mbcbot=noslip
mbctop=freeslip
sbcbot=dirichlet
sbctop=neumann
sbot=0
stop=0
sbot[thl]=None
stop[thl]=0.0
sbot[qt]=None
stop[qt]=0.0

z0m=-1
z0h=-1
swconstantz0=false
swcharnock=true
alpha_m=0.11
alpha_ch=0.018
# NOTE: we have a single `z0h` and not `z0h` and `z0q` at the moment.
#       from IFS: alpha_h=0.4, alpha_q=0.62.
alpha_h=0.50

[buffer]
swbuffer=true
swupdate=true
zstart=None
sigma=0.00223
beta=2.0

[cross]
swcross=false
xy=None
xz=0
sampletime=3600
ratio_x=None
ratio_y=None

# These settings depend on the progress of the simulation and are set for each batch by `prepare_ini.py`.
#crosslist=rrsg_bot,thl_fluxbot,qt_fluxbot,lw_flux_dn,lw_flux_up,sw_flux_dn,sw_flux_up,sw_flux_dn_clear,sw_flux_up_clear,lw_flux_dn_clear,lw_flux_up_clear,qt_path,qsat_path,qlqi_path,qi_path,t2m,u10m,v10m,thl,u,v,w500hpa
#crosslist_coarse=rrsg_bot,thl_fluxbot,qt_fluxbot,lw_flux_dn,lw_flux_up,sw_flux_dn,sw_flux_up,sw_flux_dn_clear,sw_flux_up_clear,lw_flux_dn_clear,lw_flux_up_clear,qt_path,qsat_path,qlqi_path,qi_path,t2m,u10m,v10m,thl,u,v,w500hpa
#crosslist_ymean=thl,qt,ql,qi,qr,qs,qg,u,w

[diff]
swdiff=smag2
dnmax=0.25

[dump]
swdump=false
sampletime=3600
ratio_x=None
ratio_y=None

# These settings depend on the progress of the simulation and are set for each batch by `prepare_ini.py`.
#dumplist=u,v,w,thl,qt,ql,qi,qr,qs,qg,thl_tend,qt_tend,w_tend,thl_tend_lw,thl_tend_sw,qrsg_tend_sed,qtr_tend_frz,uthl,vthl,wthl,uqt,vqt,wqt,wqr,wql,wqi,uw,vw
#dumplist_coarse=u,v,w,thl,qt,ql,qi,qr,qs,qg,thl_tend,qt_tend,w_tend,thl_tend_lw,thl_tend_sw,qrsg_tend_sed,qtr_tend_frz,uthl,vthl,wthl,uqt,vqt,wqt,wqr,wql,wqi,uw,vw

[fields]
visc=1e-05
svisc=1e-05
rndseed=2
rndamp[thl]=0.1
rndamp[qt]=2.5e-05
rndz=300.0
rndexp=2.0

[grid]
itot=None
jtot=None
ktot=None
xsize=None
ysize=None
zsize=None
utrans=0.0
vtrans=0.0
swspatialorder=2

[limiter]
limitlist=qt,qs,qg,qr
cliplist=qt,qs,qg,qr

[master]
npx=1
npy=1

[micro]
swmicro=nsw6
cflmax=1.2
Nc0=100000000

[radiation]
swradiation=rrtmgp
swlongwave=true
swshortwave=true
dt_rad=900
emis_sfc=1.0
sza=0.7339109504636155
tsi_scaling=0.4053176301654965
sfc_alb_dir=0.07
sfc_alb_dif=0.07
swclearskystats=true

[stats]
swstats=true
swtendency=false
sampletime=900

[thermo]
swthermo=moist
swbasestate=anelastic
pbot=None
swupdatebasestate=true

[time]
starttime=None
endtime=None
dt=6.0
dtmax=60
savetime=None
outputiter=1
adaptivestep=true
rkorder=3
iotimeprec=1
